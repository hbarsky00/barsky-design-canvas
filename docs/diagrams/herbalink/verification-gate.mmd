flowchart LR
  classDef old fill:#F1EEE9,stroke:#DED7CF,color:#3F4550,stroke-dasharray:4 3
  classDef gate fill:#B04321,stroke:#B04321,color:#FFFFFF
  classDef out fill:#FBFAF8,stroke:#DED7CF,color:#3F4550,stroke-dasharray:4 3
  classDef ai fill:#FFFFFF,stroke:#3F4550,color:#231E1A
  subgraph GATE[HerbaLink]
    direction LR
    h1[Practitioner applies] --> h2{Verified by the Guild?}
    h2 -->|yes| h3([Listed])
    h2 -->|no| h4[Not visible]
  end
  subgraph BADGE[Most directories]
    direction LR
    m1[Anyone lists] --> m2[Visible immediately] --> m3[Badge if a check passes]
  end
  class m1,m2,m3 old
  class h2 gate
