# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.capture-media-stash/

# Local Claude permissions — machine-specific, never commit (public repo)
.claude/settings.local.json

# macOS/iCloud conflict copies ("about 2.html") — never real output
prerendered-bodies/* [0-9]*.html

# iCloud conflict copies of env files
.env [0-9]*

# macOS/iCloud conflict copies, any extension, at any depth.
#
# This used to be an allow-list of extensions and it leaked: 28 copies were
# tracked anyway, including "package-lock 2.json" (7,383 lines), "src/index
# 2.css" (1,701) and whole directories like "src/components 2/". The extension
# list never covered .json/.js/.md/.ico/.svg/.txt/.toml, and nothing covered
# directories at all. Match the shape instead of guessing the suffix.
* [0-9].*
**/* [0-9].*
* [0-9]/
**/* [0-9]/

# Extensionless ones (e.g. "Makefile 2") and the .d.ts double-extension case
**/* [0-9]
**/*.d [0-9].ts
